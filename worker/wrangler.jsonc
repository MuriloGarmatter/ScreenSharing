// Servidor de sinalização do Telão na Cloudflare: https://telao.xmbc.workers.dev
// Publicar: npm install && npm run deploy (precisa de "npx wrangler login" uma vez).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "telao",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Variáveis criadas no painel (ex.: TURN = off, o interruptor do retransmissor)
  // continuam lá depois de cada deploy.
  "keep_vars": true,
  "preview_urls": false,
  // O Telão no navegador (iPhone, Android, Mac): a mesma interface do app, montada
  // por scripts/build-web.js em public/app/ antes de cada deploy (e no "wrangler dev").
  // Os arquivos são servidos pela Cloudflare em /app/; o resto (convites e a sala)
  // continua com o código do worker.
  "build": { "command": "node ../scripts/build-web.js" },
  "assets": { "directory": "./public" },
  "durable_objects": {
    "bindings": [{ "name": "LOBBY", "class_name": "Lobby" }]
  },
  // No plano grátis, só Durable Objects com SQLite.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby"] }]
}
